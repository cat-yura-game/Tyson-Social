# Copy public values to frontend/.env.local.
VITE_API_URL=http://localhost:8787
# Production: VITE_API_URL=https://api.368240.lol

# Put backend secrets in backend/.dev.vars locally and Cloudflare secrets in production.
# SESSION_SECRET=replace-with-at-least-32-random-bytes
# EMAIL_PROVIDER_API_KEY=development-placeholder-only
# GEMINI_API_KEY=development-placeholder-only
# GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# GEMINI_RECOMMENDATION_MODEL=gemini-3.5-flash-lite
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# TELEGRAM_OIDC_CLIENT_ID=your-public-client-id
# TELEGRAM_OIDC_CLIENT_SECRET=store-only-in-backend/.dev.vars-or-Cloudflare-secret
# TELEGRAM_OIDC_REDIRECT_URI=http://localhost:8787/api/auth/telegram/callback
