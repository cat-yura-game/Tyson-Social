{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zashugannyy-kot-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "24080501",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
