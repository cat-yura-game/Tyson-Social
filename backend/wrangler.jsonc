{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tyson-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,https://tysonsocial.eu.cc",
    "EMAIL_DELIVERY_MODE": "provider",
    "MODERATION_MODE": "gemini",
    "GEMINI_MODERATION_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_SUMMARY_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_RECOMMENDATION_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_CHAT_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_CHAT_FLASH_MODEL": "gemini-3.5-flash",
    "GEMINI_CHAT_SMART_MODEL": "gemini-3.7-flash",
    "TELEGRAM_OIDC_CLIENT_ID": "8890017118",
    "TELEGRAM_OIDC_REDIRECT_URI": "https://api.tysonsocial.eu.cc/api/auth/telegram/callback",
    "FRONTEND_URL": "https://tysonsocial.eu.cc",
    "VAPID_PUBLIC_KEY": "BC6vNepAFt0qWvtYv-7JNjEMMbLx0BRWqS6Z8YdwTNOvBkMdQrnZm5zpJu9nt2z2tcvx489gu4Pj4pXKIugHfao",
    "VAPID_SUBJECT": "https://tysonsocial.eu.cc",
    "B2_BUCKET_NAME": "tysonsocial-media-2026",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_KEY_ID": "00564c464dde85a000000002"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tyson-db",
      "database_id": "d8a1f929-7985-43ce-8e4a-3d1d8a154ae6",
      "migrations_dir": "../database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "664a57172b19434f849f1f9abf6aefb0"
    }
  ],
  "env": {
    "production": {
      "name": "tyson-api-production",
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "https://tysonsocial.eu.cc",
        "EMAIL_DELIVERY_MODE": "provider",
        "MODERATION_MODE": "gemini",
        "GEMINI_MODERATION_MODEL": "gemini-3.5-flash-lite",
        "GEMINI_SUMMARY_MODEL": "gemini-3.5-flash-lite",
        "GEMINI_RECOMMENDATION_MODEL": "gemini-3.5-flash-lite",
        "GEMINI_CHAT_MODEL": "gemini-3.5-flash-lite",
        "GEMINI_CHAT_FLASH_MODEL": "gemini-3.5-flash",
        "GEMINI_CHAT_SMART_MODEL": "gemini-3.7-flash",
        "TELEGRAM_OIDC_CLIENT_ID": "8890017118",
        "TELEGRAM_OIDC_REDIRECT_URI": "https://api.tysonsocial.eu.cc/api/auth/telegram/callback",
        "FRONTEND_URL": "https://tysonsocial.eu.cc",
        "VAPID_PUBLIC_KEY": "BC6vNepAFt0qWvtYv-7JNjEMMbLx0BRWqS6Z8YdwTNOvBkMdQrnZm5zpJu9nt2z2tcvx489gu4Pj4pXKIugHfao",
        "VAPID_SUBJECT": "https://tysonsocial.eu.cc"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tyson-db-production",
          "database_id": "581bd56d-772a-48a2-8b6b-7bd00c6234ba",
          "migrations_dir": "../database/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "MEDIA",
          "id": "059d48a90dcf4108b1ae23732b5bac78"
        }
      ]
    }
  }
}
